@echo off
setlocal EnableExtensions
title Transfert SSH key fix
color 0B

:: Always stage to C:\Temp so Admin/UAC is not blocked by OneDrive paths
mkdir C:\Temp\transfert-ssh-fix 2>nul
copy /Y "%~f0" "C:\Temp\transfert-ssh-fix\run.bat" >nul

echo.
echo ========================================
echo  Transfert HQ - SSH key fix
echo ========================================
echo Computer: %COMPUTERNAME%
echo User:     %USERNAME%
echo.
echo If Computer is VIEUXPEEPEE (HQ), CLOSE this.
echo.
echo Staged copy: C:\Temp\transfert-ssh-fix\run.bat
echo.

net session >nul 2>&1
if not errorlevel 1 goto :ADMIN_OK

echo Not admin yet.
echo.
echo OPTION A (recommended):
echo   1. Open File Explorer
echo   2. Go to C:\Temp\transfert-ssh-fix\
echo   3. Right-click run.bat -^> Run as administrator
echo   4. Click Yes on UAC
echo.
echo OPTION B: press a key now to try auto-elevate
echo           (watch for a NEW window after UAC)
echo.
pause

powershell -NoProfile -ExecutionPolicy Bypass -Command "Start-Process -FilePath 'C:\Temp\transfert-ssh-fix\run.bat' -Verb RunAs"
echo.
echo If a new window opened, use THAT one.
echo This window can be closed.
pause
exit /b

:ADMIN_OK
echo Running as Administrator...
echo Installing SSH key, please wait...
echo.
powershell -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set ERR=%ERRORLEVEL%
echo.
echo ========== LOG ==========
if exist C:\Temp\transfert-ssh-fix\log.txt (
  type C:\Temp\transfert-ssh-fix\log.txt
) else (
  echo No log file - PowerShell step failed.
)
echo ========== END ==========
echo.
if not "%ERR%"=="0" echo Exit code: %ERR%
echo.
echo Look for === DONE === above, then tell HQ.
echo.
pause
pause
endlocal
